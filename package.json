    "./tuner": {
      "types": "./dist/tuner.d.mts",
      "import": "./dist/tuner.mjs",
      "default": "./dist/tuner.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "scripts": {
    "build": "node node_modules/pkgroll/dist/cli.mjs --clean-dist --minify --sourcemap --target=es2022 --license=THIRD-PARTY-LICENSES.txt",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "check:package": "node scripts/check-package.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check": "bun run typecheck && bun run build && bun run test && bun run check:package && bun run check:packed",
    "benchmark": "node scripts/benchmark.mjs",
    "check:packed": "node scripts/check-packed.mjs",
    "benchmark:audio": "node scripts/benchmark-audio.mjs",
    "examples:audio": "node scripts/render-audio-examples.mjs",
    "build:docs": "bun run build && node scripts/build-docs.mjs",
    "dev:docs": "node scripts/serve-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "precompute:docs": "node scripts/precompute-docs.mjs",
    "check:cache": "node scripts/precompute-docs.mjs --check"
  },
  "packageManager": "bun@1.3.9",
  "volta": {
    "node": "24.13.1",
    "bun": "1.3.9"
  },
  "devDependencies": {
    "@tonaljs/note": "4.12.3",
    "@tonaljs/chord-detect": "4.9.3",
    "pkgroll": "2.29.0",
    "typescript": "5.9.3",
    "vitest": "4.0.17",
    "es-module-lexer": "2.0.0",
    "playwright": "1.62.1"
  }
}
