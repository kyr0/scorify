{
  "name": "scorify",
  "version": "0.4.0",
  "description": "Instrument-aware arrangement, transposition, fingering constraints, and plucked-string synthesis.",
  "type": "module",
  "license": "MIT",
  "author": "Aron Homberg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyr0/scorify.git"
  },
  "sideEffects": [
    "./dist/worker-entry.mjs",
    "./dist/audio-worklet.mjs",
    "./dist/pitch-worklet.mjs"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./theory": {
      "types": "./dist/theory.d.mts",
      "import": "./dist/theory.mjs",
      "default": "./dist/theory.mjs"
    },
    "./fretted": {
      "types": "./dist/fretted.d.mts",
      "import": "./dist/fretted.mjs",
      "default": "./dist/fretted.mjs"
    },
    "./presets": {
      "types": "./dist/presets.d.mts",
      "import": "./dist/presets.mjs",
      "default": "./dist/presets.mjs"
    },
    "./model": {
      "types": "./dist/model.d.mts",
      "import": "./dist/model.mjs",
      "default": "./dist/model.mjs"
    },
    "./transforms": {
      "types": "./dist/transforms.d.mts",
      "import": "./dist/transforms.mjs",
      "default": "./dist/transforms.mjs"
    },
    "./profiles": {
      "types": "./dist/profiles.d.mts",
      "import": "./dist/profiles.mjs",
      "default": "./dist/profiles.mjs"
    },
    "./analysis": {
      "types": "./dist/analysis.d.mts",
      "import": "./dist/analysis.mjs",
      "default": "./dist/analysis.mjs"
    },
    "./quantize": {
      "types": "./dist/quantize.d.mts",
      "import": "./dist/quantize.mjs",
      "default": "./dist/quantize.mjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.mts",
      "import": "./dist/adapters.mjs",
      "default": "./dist/adapters.mjs"
    },
    "./fingering": {
      "types": "./dist/fingering.d.mts",
      "import": "./dist/fingering.mjs",
      "default": "./dist/fingering.mjs"
    },
    "./arrange": {
      "types": "./dist/arrange.d.mts",
      "import": "./dist/arrange.mjs",
      "default": "./dist/arrange.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.mts",
      "import": "./dist/worker.mjs",
      "default": "./dist/worker.mjs"
    },
    "./worker-entry": {
      "types": "./dist/worker-entry.d.mts",
      "import": "./dist/worker-entry.mjs",
      "default": "./dist/worker-entry.mjs"
    },
    "./validate": {
      "types": "./dist/validate.d.mts",
      "import": "./dist/validate.mjs",
      "default": "./dist/validate.mjs"
    },
    "./performance": {
      "types": "./dist/performance.d.mts",
      "import": "./dist/performance.mjs",
      "default": "./dist/performance.mjs"
    },
    "./audio": {
      "types": "./dist/audio.d.mts",
      "import": "./dist/audio.mjs",
      "default": "./dist/audio.mjs"
    },
    "./audio-dsp": {
      "types": "./dist/audio-dsp.d.mts",
      "import": "./dist/audio-dsp.mjs",
      "default": "./dist/audio-dsp.mjs"
    },
    "./songs": {
      "types": "./dist/songs.d.mts",
      "import": "./dist/songs.mjs",
