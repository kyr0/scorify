      "default": "./dist/audio-guide.mjs"
    },
    "./audio-worklet": {
      "types": "./dist/audio-worklet.d.mts",
      "import": "./dist/audio-worklet.mjs",
      "default": "./dist/audio-worklet.mjs"
    },
    "./pitch-detect": {
      "types": "./dist/pitch-detect.d.mts",
      "import": "./dist/pitch-detect.mjs",
      "default": "./dist/pitch-detect.mjs"
    },
    "./pitch-worklet": {
      "types": "./dist/pitch-worklet.d.mts",
